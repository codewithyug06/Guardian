# Guardian AI Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# OpenAI API Key for Multi-Agent Swarm Intelligence & Vision/Whisper Models
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Supabase Authentication & Database Integration (Optional)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_publishable_key_here

# Backend & CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POLICY_FILE_PATH=../internal_policy.txt
PORT=8000
